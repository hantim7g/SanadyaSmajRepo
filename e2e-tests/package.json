{
  "name": "sanadya-smaj-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Sanadya Brahmin Smaj webapp using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:login": "playwright test tests/login.spec.js --headed",
    "test:members": "playwright test tests/members.spec.js --headed",
    "test:payments": "playwright test tests/payments.spec.js --headed",
    "test:report": "playwright show-report",
    "install-browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
